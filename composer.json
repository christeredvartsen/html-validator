{
  "name": "christeredvartsen/html-validator",
  "type": "library",
  "description": "Validates HTML using Validator.nu",
  "keywords": [
    "html",
    "validator"
  ],
  "homepage": "https://github.com/christeredvartsen/html-validator",
  "license": "MIT",
  "authors": [
    {
      "name": "Christer Edvartsen",
      "email": "cogo@starzinger.net"
    },
    {
      "name": "Espen Hovlandsdal",
      "email": "espen@hovlandsdal.com"
    },
    {
      "name": "Contributors",
      "homepage": "https://github.com/christeredvartsen/html-validator/graphs/contributors"
    }
  ],
  "support": {
    "issues": "https://github.com/christeredvartsen/html-validator/issues",
    "source": "https://github.com/christeredvartsen/html-validator",
    "docs": "https://github.com/christeredvartsen/html-validator"
  },
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^8.1"
  },
  "require-dev": {
    "ext-dom": "*",
    "friendsofphp/php-cs-fixer": "^3.95",
    "imbo/imbo-coding-standard": "^3.0",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpunit/phpunit": "^12.5",
    "ramsey/conventional-commits": "^1.7",
    "symfony/var-dumper": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "HtmlValidator\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HtmlValidator\\": "tests/"
    }
  },
  "scripts": {
    "ci": [
      "@cs",
      "@sa",
      "@test"
    ],
    "cs": "vendor/bin/php-cs-fixer check --diff",
    "cs:fix": "vendor/bin/php-cs-fixer fix --diff",
    "sa": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/phpunit",
    "test:coverage": "@test --coverage-html build/coverage"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  }
}
