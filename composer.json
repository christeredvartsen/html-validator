{
  "name": "christeredvartsen/html-validator",
  "type": "library",
  "description": "Validates HTML using Validator.nu",
  "keywords": [
    "html",
    "validator"
  ],
  "homepage": "https://github.com/christeredvartsen/html-validator",
  "license": "MIT",
  "authors": [
    {
      "name": "Christer Edvartsen",
      "email": "cogo@starzinger.net"
    },
    {
      "name": "Espen Hovlandsdal",
      "email": "espen@hovlandsdal.com"
    },
    {
      "name": "Contributors",
      "homepage": "https://github.com/christeredvartsen/html-validator/graphs/contributors"
    }
  ],
  "support": {
    "issues": "https://github.com/christeredvartsen/html-validator/issues",
    "source": "https://github.com/christeredvartsen/html-validator",
    "docs": "https://github.com/christeredvartsen/html-validator"
  },
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "ext-dom": "*",
    "guzzlehttp/guzzle": "^8.1"
  },
  "require-dev": {
    "ext-dom": "*",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "HtmlValidator\\": "src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "HtmlValidator\\": "tests/"
    }
  },
  "scripts": {
    "phpunit": "vendor/bin/phpunit",
    "phpunit:coverage": "@phpunit --coverage-html build/coverage",
    "test": [
      "@phpunit"
    ],
    "ci": [
      "@phpunit"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
